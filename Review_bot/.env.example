# GitLab Configuration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_PROJECT_ID=

# AI Provider Credentials
# Options: openai, gemini, ollama, groq
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder

OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Local or Remote Ollama Machine Settings
# e.g., http://localhost:11434 or http://192.168.1.100:11434 or http://ollama.company.local:11434
OLLAMA_BASE_URL=http://localhost:11434
# Optional API Key or Auth Token if remote server/proxy requires authentication
OLLAMA_API_KEY=your_remote_ollama_api_key

GROQ_API_KEY=your_groq_api_key

# Review Configuration
REVIEW_STRICTNESS=medium # low, medium, high
AUTO_POST_GITLAB_COMMENT=false
